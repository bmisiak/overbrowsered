<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  IgnorableNamespaces="desktop desktop6 rescap uap uap10">

  <!--
    Identity Name and Publisher must exactly match the values assigned by
    Microsoft Partner Center. The packaging script substitutes all @...@
    tokens before invoking MakeAppx.
  -->
  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="@ARCHITECTURE@" />

  <Properties>
    <DisplayName>Overbrowsered</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Description>Opens links in your most recently used browser</Description>
    <Logo>Assets\StoreLogo.png</Logo>

    <!--
      http and https are reserved URI schemes, so windows.protocol manifest
      declarations for them are ignored by Windows. Overbrowsered must retain
      its Win32 Default Programs registration under HKCU. Disabling registry
      write virtualization makes those keys visible to Default Apps rather
      than trapping them in the package's private registry.

      This requires the restricted unvirtualizedResources capability below.
      These HKCU values are not automatically deleted when the MSIX is removed.
    -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="Overbrowsered"
      Executable="overbrowsered.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="Overbrowsered"
        Description="Opens links in your most recently used browser"
        BackgroundColor="transparent"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" />

      <Extensions>
        <!-- Enabled after the first app launch; users can disable it in Startup Apps. -->
        <desktop:Extension
          Category="windows.startupTask"
          Executable="overbrowsered.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="OverbrowseredStartup"
            Enabled="true"
            DisplayName="Overbrowsered" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
